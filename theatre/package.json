{
  "name": "kino-theatre",
  "version": "0.1.0",
  "private": true,
  "description": "Kino Enhanced theatre: Cloudflare Worker + Durable Objects that sync screens",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "deploy": "node scripts/deploy.mjs",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.mjs\"",
    "check": "npm run typecheck && npm run format:check && npm test"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.168.0"
  }
}
